# Next.js API proxy, never a browser-exposed secret
BRANDORA_API_URL=http://127.0.0.1:8200
# API environment: local by default. production disables demo/signup and requires HTTPS.
BRANDORA_ENV=local
BRANDORA_DEMO=1
ALLOWED_ORIGINS=http://127.0.0.1:3200,http://localhost:3200
# Optional PostgreSQL. SQLite is the default; do not commit real credentials.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/brandora
# Optional external AI. Configure both on the API server, then enable in Privacy.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
BRANDORA_AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=configure-in-your-server-environment
BRANDORA_AI_DAILY_LIMIT=30
BRANDORA_AI_GLOBAL_LIMIT=200
BRANDORA_EXPLORE_DEMO=1
BRANDORA_DEMO_AI_GLOBAL_LIMIT=80
# Production only: one-time first workspace setup, disabled after the first user exists.
# BRANDORA_SETUP_TOKEN=generate-a-long-random-value
